// Prisma schema for Espacio Cultural Saravá CMS

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  author      String
  date        DateTime  @db.Date
  displayDate String
  excerpt     String
  tags        String[]
  image       String
  featured    Boolean   @default(false)
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  comments    Comment[]

  @@index([published, date])
  @@index([published, featured])
}

model Event {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  date        DateTime @db.Date
  displayDate String
  summary     String
  schedule    String
  ctaLabel    String
  ctaHref     String
  category    String
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, featured])
  @@index([category])
}

model Novel {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  coverImage  String
  description String
  pdfUrl      String?
  active      Boolean   @default(false)
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  comments    Comment[]

  @@index([active, published])
}

/// Singleton row for "Sobre nosotras" content.
model About {
  id         String   @id @default("about")
  highlights Json
  paragraphs String[]
  team       Json
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
}

/// Singleton row for site-wide branding.
model SiteSettings {
  id        String   @id @default("site")
  logoUrl   String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Comment {
  id            String   @id @default(cuid())
  body          String
  authorClerkId String
  authorName    String
  authorImage   String?
  postId        String?
  novelId       String?
  /// Static page key for comments outside posts/novels (e.g. "radio-streaming", "podcast").
  pageKey       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  post          Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  novel         Novel?   @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([novelId, createdAt])
  @@index([pageKey, createdAt])
  @@index([authorClerkId])
}
