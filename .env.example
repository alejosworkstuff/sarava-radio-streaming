# Public site URL (set after first Vercel deploy / custom domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clerk — lectores pueden registrarse; /admin sigue gated por ADMIN_EMAIL
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Admin allowlist — comma-separated emails
ADMIN_EMAIL=saravagente@gmail.com,alejoworkstuff@gmail.com

# Neon Postgres (Fase 2) — use sslmode=verify-full (not require) to avoid pg deprecation warning
DATABASE_URL=

# Vercel Blob (Fase 3)
BLOB_READ_WRITE_TOKEN=
